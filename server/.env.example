PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Temporary sideload-test bypass. Keep false for every store/production release.
ALLOW_DEVELOPMENT_PREVIEW=false

# Obligr OTP delivery. Keep secrets only in the server environment.
OTP_PROVIDER=obligr
OBLIGR_OTP_ENDPOINT=https://obligr.io/api_v2/message/send
OBLIGR_API_KEY=
OTP_HASH_SECRET=
OTP_MESSAGE_TEMPLATE=Your OTP for mobile number verification on Din Din is {OTP}. It is valid for 10 minutes. Do not share this OTP with anyone.

# Optional Google Play reviewer access. This exact account bypasses SMS delivery only;
# it still creates a rate-limited, expiring OTP challenge. Keep both values server-side.
PLAY_REVIEW_PHONE=
PLAY_REVIEW_OTP=

# Firebase Cloud Messaging. Keep the Admin JSON outside the source tree.
FIREBASE_PROJECT_ID=din-din-a5224
GOOGLE_APPLICATION_CREDENTIALS=/etc/dindin-firebase-admin.json

# Neon Postgres: pooled URL for API traffic, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Techies Solutions WhatsApp Business template delivery.
TECHIES_WHATSAPP_ENDPOINT=https://login.techiessolutions.in/whatsappbusiness/send-templated-message
TECHIES_WHATSAPP_API_KEY=
TECHIES_WHATSAPP_SENDER=
TECHIES_WHATSAPP_CAMPAIGN_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Put this secret in the webhook URL as ?token=... when configuring Techies.
TECHIES_WHATSAPP_WEBHOOK_SECRET=
# A separate, random 32-byte-or-longer secret used to sign 24-hour alert links.
ALERT_LINK_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-token

# Google Play Real-time Developer Notifications (RTDN).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Store verification must be configured before production release.
GOOGLE_PLAY_PACKAGE_NAME=info.dindin.app
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLE_BUNDLE_ID=info.dindin.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVER_NOTIFICATION_ENVIRONMENT=Sandbox
